Bootstrap: docker
From: vibpsb/i-adhore:3.1

%labels
    Maintainer Cecilia Sensalari

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export DEBIAN_FRONTEND=noninteractive

%files
    vendor/paml4.9j.tgz /paml4.9j.tgz
    requirements.txt /ksrates/requirements.txt
    setup.py /ksrates/setup.py
    ksrates /ksrates/ksrates
    wgd_ksrates /ksrates/wgd_ksrates
    README.md /ksrates/README.md
    ksrates_cli.py /ksrates/ksrates_cli.py

%post
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export DEBIAN_FRONTEND=noninteractive

    # Install Python 3.9.
    apt-get update
    apt-get install -y software-properties-common
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update
    apt-get install -y python3.9 python3.9-distutils
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.9
    python3.9 -m pip install --upgrade pip

    # Install non-Python wgd dependencies.
    apt-get update
    apt-get install -yq \
        wget \
        git \
        curl \
        default-jdk \
        build-essential \
        mcl \
        ncbi-blast+ \
        muscle \
        fasttree

    # Install PAML from source.
    tar -xzf /paml4.9j.tgz -C /
    cd /paml4.9j/src
    make -f Makefile
    mv codeml /bin
    cd /

    # Install DIAMOND.
    wget http://github.com/bbuchfink/diamond/releases/download/v2.1.9/diamond-linux64.tar.gz
    tar -xzf diamond-linux64.tar.gz
    mv diamond /bin

    # Install OrthoMCLight.
    wget https://raw.githubusercontent.com/VIB-PSB/OrthoMCLight/main/orthomclight.pl -P /bin
    wget https://raw.githubusercontent.com/VIB-PSB/OrthoMCLight/main/orthomclight_module.pm -P /bin
    chmod a+rx /usr/bin/orthomclight*

    # Download the 37 angiosperm sequence archive into the Python package.
    wget https://zenodo.org/records/15225340/files/original_angiosperm_sequences.tar.gz \
        -P /ksrates/ksrates/reciprocal_retention

    # Install ksrates and its Python requirements.
    python3.9 -m pip install -r /ksrates/requirements.txt
    python3.9 -m pip install /ksrates
    rm -r /ksrates
